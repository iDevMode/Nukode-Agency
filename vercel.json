{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "crons": [
    {
      "path": "/api/keep-alive",
      "schedule": "0 8 */5 * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/report",
      "destination": "/report.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
